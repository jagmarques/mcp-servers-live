    "id": "loosephoto/space-finder-mcp",
    "install_info": {
      "claude_config": "{\n  \"mcpServers\": {\n    \"space-finder-mcp\": {\n      \"command\": \"uv\",\n      \"args\": [\"--directory\", \"/\u7d76\u5bfe\u30d1\u30b9/space-finder-mcp\", \"run\", \"space-finder-mcp\"]\n    }\n  }\n}",
      "install_cmd": "claude mcp add -s project space-finder -- uv --directory \"$(pwd)\" run space-finder-mcp",
